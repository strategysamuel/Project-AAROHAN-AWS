{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Persona",
  "type": "object",
  "properties": {
    "scenario_id": { "type": "string" },
    "persona_name": { "type": "string" },
    "pan": { "type": "string", "pattern": "^SIM[A-Z]{2}[0-9]{4}[A-Z]$" },
    "gstin": { "type": "string", "pattern": "^[0-9]{2}SIM[A-Z]{2}[0-9]{4}[A-Z][0-9]Z[0-9]$" },
    "business_type": { "type": "string" },
    "expected_credit_outcome": { "type": "string", "enum": ["APPROVED", "MANUAL_REVIEW", "REJECTED"] },
    "fhc_score_target": { "type": "integer", "minimum": 0, "maximum": 100 },
    "ckyc_status": { "type": "string", "enum": ["CLEAN", "EXPIRED", "INCOMPLETE"] },
    "gst_profile": { "type": "string", "enum": ["HIGH_GROWTH", "STABLE", "SEASONAL", "DECLINING"] },
    "aa_cash_flow_profile": { "type": "string", "enum": ["STRONG_CASHFLOW", "SEASONAL_CASHFLOW", "WEAK_CASHFLOW"] },
    "epfo_status": { "type": "string", "enum": ["GROWING_WORKFORCE", "STABLE_WORKFORCE", "DECLINING_WORKFORCE", "NON_COMPLIANT"] },
    "mca_status": { "type": "string", "enum": ["ACTIVE_COMPLIANT", "ACTIVE_NON_COMPLIANT", "INACTIVE"] },
    "rbi_fraud_status": { "type": "string", "enum": ["CLEAN", "SUSPICIOUS", "BLACKLISTED"] },
    "explainability_tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "mudra_eligible": { "type": "boolean" },
    "scheme_tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "kcc_eligible": { "type": "boolean" },
    "ecgc_coverage": { "type": "boolean" }
  },
  "required": [
    "scenario_id",
    "persona_name",
    "pan",
    "gstin",
    "business_type",
    "expected_credit_outcome",
    "fhc_score_target",
    "ckyc_status",
    "gst_profile",
    "aa_cash_flow_profile",
    "epfo_status",
    "mca_status",
    "rbi_fraud_status",
    "explainability_tags"
  ]
}
