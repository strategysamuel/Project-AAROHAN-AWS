{
  "family": "aarohan-executive-intelligence",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::905417996641:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "executive-intelligence",
      "image": "905417996641.dkr.ecr.ap-south-1.amazonaws.com/aarohan/executive:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 9009,
          "protocol": "tcp"
        },
        {
          "containerPort": 9010,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "PYTHONPATH",
          "value": "/app/services/ese-core"
        },
        {
          "name": "INTEGRATION_PROFILE",
          "value": "DEMO"
        },
        {
          "name": "ACTIVE_DATASET",
          "value": "msme"
        }
      ],
      "healthCheck": {
        "command": ["CMD-SHELL", "curl -f http://localhost:9009/livez || exit 1"],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 20
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/aarohan-executive-intelligence",
          "awslogs-region": "ap-south-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
